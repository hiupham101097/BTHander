{
  "name": "aurix-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "wrangler dev",
    "migrate:remote": "wrangler d1 migrations apply app-db --remote",
    "lint": "eslint src --ext .js,.jsx",
    "deploy": "npm run deploy:worker",
    "deploy:worker": "npm run check && npm run migrate:remote && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply app-db --local",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check:budget": "node scripts/check-budget.mjs",
    "check": "npm run lint && npm test && npm run build && npm run check:budget",
    "images:optimize": "python scripts/optimize-images.py"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "vite": "^6.0.0",
    "wrangler": "4.142.0"
  }
}
